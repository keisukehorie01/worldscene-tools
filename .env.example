# Drop2PPT / WorldScene Tools environment template
# Copy this file to .env on the server and fill in real values.

# Public site URL
PUBLIC_BASE_URL=https://worldscene.net
PUBLIC_APP_URL=https://worldscene.net/drop2ppt
SECRET_KEY=change-this-long-random-secret

# Main Stripe keys. Use live keys for production.
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_HIGH_QUALITY=price_xxxxxxxxxxxxxxxxxxxxx

# Optional owner-only Stripe sandbox checkout.
# Visit /drop2ppt/auth.html?mode=sandbox and log in with these owner-only credentials.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_PRICE_HIGH_QUALITY=price_xxxxxxxxxxxxxxxxxxxxx
DROP2PPT_SANDBOX_EMAIL=owner@example.com
DROP2PPT_SANDBOX_PASSWORD=change-this-private-password

# SMTP for Drop2PPT account verification and password reset.
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_DEFAULT_SENDER=noreply@example.com
MAIL_FROM_NAME=Drop2PPT

# AI image analysis / PPT reconstruction
PPT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj_xxxxxxxxxxxxxxxxxxxxx
PPT_OPENAI_MODEL=gpt-4.1-mini

# Optional Gemini fallback, only used if PPT_AI_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx
PPT_GEMINI_MODEL=gemini-3.5-flash

# Optional runtime paths and limits
PPT_RUNTIME_DIR=/var/www/worldscene-tools/api/runtime/ppt_jobs
BILLING_DB_PATH=/var/www/worldscene-tools/api/runtime/billing.sqlite3
PPT_MAX_UPLOAD_BYTES=12582912
PPT_MAX_IMAGE_REGIONS=8
PPT_STANDARD_MAX_IMAGE_REGIONS=4
PPT_IMAGE_REGION_MIN_AREA=0.006
PPT_DEFAULT_JA_FONT=Yu Gothic
PPT_SERIF_JA_FONT=Yu Mincho
PPT_DEFAULT_LATIN_FONT=Aptos

# Malware scan for uploaded images.
# Install ClamAV on the server and keep this required for production.
PPT_MALWARE_SCAN_ENABLED=true
PPT_REQUIRE_MALWARE_SCAN=true
PPT_MALWARE_SCAN_COMMAND=clamdscan --no-summary --fdpass {path}
PPT_MALWARE_SCAN_TIMEOUT=60
